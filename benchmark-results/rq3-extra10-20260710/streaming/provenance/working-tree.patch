+func responseChannelBuffer() int {
+	const defaultResponseChannelBuffer = 1024
+	value := strings.TrimSpace(os.Getenv("AGENT_RESPONSE_CHANNEL_BUFFER"))
+	if value == "" {
+		return defaultResponseChannelBuffer
+	}
+	parsed, err := strconv.Atoi(value)
+	if err != nil || parsed <= 0 {
+		logger.Sugar().Warnw("Invalid AGENT_RESPONSE_CHANNEL_BUFFER, using default", "value", value, "default", defaultResponseChannelBuffer)
+		return defaultResponseChannelBuffer
+	}
+	return parsed
+}
